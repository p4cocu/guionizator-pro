# Copiá este archivo como workers/.env y completá los valores.
# NUNCA commitear workers/.env — está en .gitignore.

# URL de tu proyecto Supabase (igual que NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key — necesaria para que el worker bypasee RLS y lea access_token de IG.
# La encontrás en Supabase → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alertas por Telegram (opcional — si no se setean, se omiten silenciosamente).
# Usá tu bot existente: @BotFather te da el token, /getUpdates te da el chat_id.
TELEGRAM_BOT_TOKEN=123456789:AAFxxx...
TELEGRAM_CHAT_ID=987654321
