# ============================================================
# Guionizator Pro — variables de entorno
# Copia este archivo a .env.local y rellena con tus valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, ej. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (pública, segura para el browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
# SOLO server-side. Nunca usar el prefijo NEXT_PUBLIC con esta key.
ANTHROPIC_API_KEY=

# URL pública del sitio (para callbacks de auth en producción)
# Local: http://localhost:3000  |  Prod: https://guionizator.pacocuevasia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Apify (apify.com → Settings → Integrations → API tokens) ---
# SOLO server-side. Se usa para el scraper de competencia (Instagram Scraper).
# Es el token GLOBAL / fallback: se usa para los clientes que no tengan el suyo
# cargado en su perfil (ver SECRETS_KEY abajo), y SOLO si el dueño de esos
# clientes es el super admin (ver SUPER_ADMIN_USER_ID).
APIFY_API_TOKEN=

# --- Super admin (dueño de la plataforma) ---
# uuid del usuario en auth.users. Es el único que puede caer al APIFY_API_TOKEN
# global cuando un cliente no tiene key propia; cualquier otro usuario está
# obligado a cargar la suya. Si no se define, NADIE usa el token global.
SUPER_ADMIN_USER_ID=

# --- Cifrado de secretos por cliente (token de Apify de cada marca) ---
# 32 bytes en base64. Genérala con:  openssl rand -base64 32
# Va en local Y en Netlify, con el MISMO valor: si cambia, los tokens ya
# guardados no se pueden descifrar y hay que volver a cargarlos.
SECRETS_KEY=

# --- Llave de servidor de Supabase (service_role) ---
# Supabase → Project Settings → API → service_role. SALTEA la RLS: solo
# server-side, NUNCA con prefijo NEXT_PUBLIC y nunca en el browser.
# Va en local Y en Netlify (desde la migración 0006): los tokens de Apify viven
# en `client_secrets`, tabla sin permisos para el browser, y sin esta key el
# perfil del cliente no puede mostrar ni verificar su token.
# La usan además las Netlify Functions (scraper, crons de limpieza y de tokens).
SUPABASE_SERVICE_ROLE_KEY=

# --- Competencia: ejecutor async en producción (Netlify) ---
# Solo en Netlify (no en local): en local el scrape corre síncrono dentro de la
# app. Cualquier string secreto que generes tú.
SCRAPE_FN_SECRET=

# --- Transcripción de videos (platform.openai.com → API Keys) ---
# SOLO server-side. Whisper (OpenAI) — no es la misma cuenta que Anthropic.
# Transcribe los posts de Competencia, desde /competencia (sin tope) y desde
# el add-on del portal (con tope, clients.transcription_limit).
OPENAI_API_KEY=

# --- Stripe (dashboard.stripe.com) — Fase E ---
# TODO SOLO server-side. NUNCA con prefijo NEXT_PUBLIC.
# No hace falta publishable key: se usa Checkout hospedado, así que el servidor
# crea la sesión y el browser se redirige a checkout.stripe.com. Ningún dato de
# tarjeta pasa por esta app.
#
# Developers → API keys. sk_test_… en local, sk_live_… en Netlify.
STRIPE_SECRET_KEY=

# Firma del webhook. Es DISTINTO en local y en producción:
#   local      → lo imprime `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#   producción → sale del endpoint que registres en Developers → Webhooks
# Sin el correcto, la firma no valida y el webhook responde 400 a todo.
STRIPE_WEBHOOK_SECRET=

# Los price_… de los tres productos. OJO: son objetos distintos en la cuenta de
# test y en la de live — cargar uno de test en producción NO da error, cobra $0.
STRIPE_PRICE_SUBSCRIPTION=   # $300 MXN / mes, recurrente
STRIPE_PRICE_CREDITS_20=     # $100 MXN, pago único, 20 créditos
STRIPE_PRICE_CREDITS_50=     # $200 MXN, pago único, 50 créditos

# --- Corte por impago (Fase E) ---
# `true` enciende el candado: una marca sin pagar deja de entrar al portal.
# Con cualquier otro valor (o sin definir) el cobro funciona completo pero NADIE
# se corta — es lo que permite deployar toda la maquinaria y encenderla después,
# en vez de que el primer deploy sea también el primer corte.
BILLING_ENFORCED=false
