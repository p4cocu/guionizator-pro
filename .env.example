# ============================================================
# Guionizator Pro — variables de entorno
# Copia este archivo a .env.local y rellena con tus valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, ej. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (pública, segura para el browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
# SOLO server-side. Nunca usar el prefijo NEXT_PUBLIC con esta key.
ANTHROPIC_API_KEY=

# URL pública del sitio (para callbacks de auth en producción)
# Local: http://localhost:3000  |  Prod: https://guionizator.pacocuevasia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Apify (apify.com → Settings → Integrations → API tokens) ---
# SOLO server-side. Se usa para el scraper de competencia (Instagram Scraper).
APIFY_API_TOKEN=

# --- Competencia: ejecutor async en producción (Netlify) ---
# Estas DOS solo se configuran en Netlify (no en local). En local el scrape
# corre síncrono dentro de la app. En prod, defínelas para usar la Background
# Function y evitar timeouts:
#   SUPABASE_SERVICE_ROLE_KEY  → Supabase → Project Settings → API (service_role)
#   SCRAPE_FN_SECRET           → cualquier string secreto que tú generes
SUPABASE_SERVICE_ROLE_KEY=
SCRAPE_FN_SECRET=

# --- Transcripción local con Whisper (solo Mac / npm run dev) ---
# Activa el botón "Transcribir" en los post cards de Competencia.
# NUNCA poner en true en Netlify — la función solo funciona en localhost.
NEXT_PUBLIC_TRANSCRIBE_ENABLED=false
