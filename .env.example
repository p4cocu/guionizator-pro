# ============================================================
# Guionizator Pro — variables de entorno
# Copia este archivo a .env.local y rellena con tus valores reales.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Supabase (Project Settings → API) ---
# URL del proyecto, ej. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (pública, segura para el browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
# SOLO server-side. Nunca usar el prefijo NEXT_PUBLIC con esta key.
ANTHROPIC_API_KEY=

# URL pública del sitio (para callbacks de auth en producción)
# Local: http://localhost:3000  |  Prod: https://guionizator.pacocuevasia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
